# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GEMINI_API_KEY=
JWT_SECRET=
# Optional: OpenAI platform key used only to export Agents SDK traces
OPENAI_TRACING_KEY=

DATABASE_URL=sqlite:///./hcm_ai.db
CHAT_MODEL=openai/gpt-oss-120b
FAST_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=15
AI_RATE_LIMIT_PER_HOUR=20
GEMINI_MODEL=gemini-2.5-flash
AGENT_MAX_TURNS=5
CHAT_MAX_TOKENS=512
CORS_ORIGINS=
APP_TIMEZONE=Asia/Karachi
ENABLE_DOCS=false
MAX_BODY_BYTES=32768
REASONING_EFFORT=low
# AI_API_KEY is accepted as an alias of GROQ_API_KEY (name used in the hackathon brief).
# Demo sign-in cards (stand-in for M1 login). Keep false in any real deployment.
DEMO_MODE=false
